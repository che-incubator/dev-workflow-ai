{
  "name": "dev-workflow-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Autonomous AI software engineer — automates the issue→PR→review→fix loop across any GitHub project",
  "license": "EPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": {
    "packages": [
      "packages/agent-backend",
      "packages/agent-frontend"
    ]
  },
  "scripts": {
    "dev": "bash scripts/dev-api.sh",
    "start:prepare": "yarn tsx scripts/init-db.ts && bash scripts/dev-api.sh",
    "start": "yarn workspace @dev-workflow-ai/agent-frontend dev",
    "build": "yarn workspaces foreach -A run build",
    "run-issue": "yarn tsx scripts/run-issue-direct.ts",
    "test": "vitest run",
    "lint:check": "yarn workspaces foreach -A run lint:check",
    "lint:fix": "yarn workspaces foreach -A run lint:fix",
    "format:check": "yarn workspaces foreach -A run format:check",
    "format:fix": "yarn workspaces foreach -A run format:fix",
    "typecheck": "tsc --noEmit",
    "license:check": "license-tool --check",
    "license:generate": "license-tool --harvest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.0",
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.10",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.12",
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^11.0.2",
    "gray-matter": "^4.0.3",
    "pg": "^8.12.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eclipse-che/license-tool": "^2.0.1-next.7742774",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.34",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.3.0",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
