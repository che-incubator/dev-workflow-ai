# dev-workflow-ai — environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# ── Eclipse Che / OpenShift workspaces ────────────────────────────────────────
# Do NOT define credentials in devfile.yaml — use one of these two approaches:
#
# Option A — bulk script (recommended):
#   source .env && ./run/create-ocp-secret.sh --namespace <your-namespace>
#
# Option B — per-variable oc apply (useful for a single key):
#   oc apply -f - <<EOF
#   kind: Secret
#   apiVersion: v1
#   metadata:
#     name: gemini-api-key
#     labels:
#       controller.devfile.io/mount-to-devworkspace: 'true'
#       controller.devfile.io/watch-secret: 'true'
#     annotations:
#       controller.devfile.io/mount-as: env
#   data:
#     GEMINI_API_KEY: <base64-encoded-value>   # echo -n 'your-key' | base64
#   type: Opaque
#   EOF
#
# See README.md § "Open in Eclipse Che" for the full variable-to-secret mapping.

# ── GitHub ────────────────────────────────────────────────────────────────────
# Required to open real PRs. Omit for dry-run mode (output written to output/).
GITHUB_TOKEN=ghp_...

# ── LLM — choose one (priority: Vertex AI > Anthropic > Gemini > Ollama) ─────

# Claude via Google Cloud Vertex AI
# Credentials via inline JSON (recommended for secrets / k8s):
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=global
VERTEX_CLAUDE_MODEL=claude-sonnet-4-6@default
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Claude via Anthropic API (direct)
ANTHROPIC_API_KEY=

# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# External Ollama (running on your intranet or local machine)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5-coder:7b

# ── Jira (optional — for assigned-to-me issue sync) ───────────────────────────
JIRA_TOKEN=
JIRA_EMAIL=
JIRA_BASE_URL=https://redhat.atlassian.net

# ── Database (optional — defaults to embedded PGlite when not set) ────────────
# Uncomment to use an external Postgres instead of PGlite:
# DATABASE_URL=postgres://agent:agent@localhost:5433/devworkflow
