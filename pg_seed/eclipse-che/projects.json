{
  "issue_sources": [
    "https://redhat.atlassian.net/jira/for-you?tab=assigned",
    "https://github.com/eclipse-che/che/issues"
  ],
  "projects": {
    "che-dashboard": {
      "repo": "eclipse-che/che-dashboard",
      "local_path": "/Users/oleksiiorel/workspace/eclipse-che/che-dashboard",
      "context": "subprojects/che-dashboard/context.md",
      "rules": "subprojects/che-dashboard/rules/dev.md",
      "auto_approve": { "min_priority": "major" },
      "stack": ["TypeScript", "React 18", "PatternFly 5", "Redux Toolkit", "Yarn workspaces", "Fastify"],
      "issue_labels_filter": ["area/dashboard-frontend", "area/dashboard-backend", "kind/bug", "kind/enhancement"],
      "exclude_labels": ["needs-triage"],
      "coding_standards": [
        "TypeScript strict mode — no any, no casting to any",
        "Absolute imports with @/ alias only — never relative imports",
        "PatternFly 5 components only",
        "EPL-2.0 copyright header in all source files",
        "yarn license:generate after any package.json or yarn.lock change",
        "stylelint-config-clean-order CSS property ordering"
      ],
      "review_criteria": {
        "test_coverage_min_pct": 80,
        "no_any_type": true,
        "no_relative_imports": true,
        "prettier": true,
        "eslint": true,
        "license_regen_required": true
      },
      "pre_commit": [
        "yarn lint:fix",
        "yarn format:fix",
        "yarn workspace @eclipse-che/dashboard-frontend test --testPathPatterns=\"<ComponentName>\" --no-cache"
      ],
      "pre_push": ["yarn build", "yarn test"],
      "pr_template": "eclipse-che/che-dashboard"
    },
    "che-server": {
      "repo": "eclipse-che/che-server",
      "local_path": "/Users/oleksiiorel/workspace/eclipse-che/che-server",
