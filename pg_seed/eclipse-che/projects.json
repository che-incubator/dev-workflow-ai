      "rules": "subprojects/che-server/rules/dev.md",
      "stack": ["Java 17", "Quarkus", "Maven"],
      "issue_labels_filter": ["kind/bug", "kind/enhancement"],
      "coding_standards": [
        "Java 17+",
        "Quarkus CDI injection via @Inject — never new for services",
        "EPL-2.0 header in all source files",
        "No wildcard imports",
        "Checkstyle must pass"
      ],
      "review_criteria": { "mvn_test": true, "checkstyle": true },
      "pre_commit": ["mvn checkstyle:check", "mvn test -pl <module> -am"],
      "pre_push": ["mvn clean install"]
    },
    "che-ai-tool-images": {
